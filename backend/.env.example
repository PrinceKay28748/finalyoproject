# Backend Environment Variables
# Copy this to .env and fill in your values.
# Production (Render): set NODE_ENV=production and DATABASE_URL only — SQLite is not used.

NODE_ENV=development
PORT=3001

# Supabase (required for auth sync, password reset emails, account deletion)
# Use the SAME Supabase project as production so login works locally.
SUPABASE_URL=https://prrgxvxvmxgsheutuqjb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBycmd4dnh2bXhnc2hldXR1cWpiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzczMzQ3OSwiZXhwIjoyMDkzMzA5NDc5fQ.vDA9q2ww12sZ3sgUUvb9_nhziG91Qoq7HIZymS3wiZI
# Frontend URL (used in password-reset email links)
FRONTEND_URL=http://localhost:5173

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your_random_32_char_string_here_replace_me
JWT_REFRESH_SECRET=your_random_32_char_string_here_replace_me

# Token Expiration
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Optional email (SMTP blocked on Render free tier)
# EMAIL_USER=
# EMAIL_PASS=

# ── Production only (do NOT set locally unless testing against Supabase PG) ──
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
